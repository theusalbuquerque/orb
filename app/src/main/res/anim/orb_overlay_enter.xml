<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="240" />
    <scale
        android:fromXScale="0.965" android:toXScale="1.0"
        android:fromYScale="0.965" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="60%"
        android:duration="280" />
    <translate android:fromYDelta="3%p" android:toYDelta="0" android:duration="280" />
</set>
