<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_linear_in">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="170" />
    <scale
        android:fromXScale="1.0" android:toXScale="0.985"
        android:fromYScale="1.0" android:toYScale="0.985"
        android:pivotX="50%" android:pivotY="60%"
        android:duration="180" />
    <translate android:fromYDelta="0" android:toYDelta="1.5%p" android:duration="180" />
</set>
